# OpenAI-compatible judge endpoint.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=


JUDGE_TEMPERATURE=0
JUDGE_MAX_TOKENS=10120
JUDGE_TIMEOUT=30
JUDGE_MAX_RETRIES=2
JUDGE_MAX_INFLIGHT=16
JUDGE_THINKING=0
JUDGE_MIN_INTERVAL=0.05

# User simulator endpoint. Keep these explicit so SIMULATOR_TIMEOUT is honored.
SIMULATOR_BASE_URL=${JUDGE_BASE_URL}
SIMULATOR_API_KEY=${JUDGE_API_KEY}
SIMULATOR_MODEL=${JUDGE_MODEL}
SIMULATOR_TEMPERATURE=1.0
SIMULATOR_MAX_WORKERS=16
SIMULATOR_MAX_RETRIES=2
SIMULATOR_TIMEOUT=30

# Debug phase: use 1 to stop on reward failures, 0 to convert failures to score 0.
ONLINE_REWARD_FAIL_FAST=0
ONLINE_REWARD_DEBUG_PATH=${LOG_DIR}/reward_debug.jsonl
